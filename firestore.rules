rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person reads and writes only their own library.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Shared, read-only copies of someone's crates: anyone with the link can read;
    // only the person who made the share can create, change or delete it.
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /images/{imageId} {
        allow read: if true;
        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/shares/$(shareId)).data.owner == request.auth.uid;
      }
    }
  }
}
